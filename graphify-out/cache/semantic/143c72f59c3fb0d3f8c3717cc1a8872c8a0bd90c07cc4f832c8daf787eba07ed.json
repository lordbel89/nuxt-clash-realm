{"nodes": [{"id": "engine_tournament_engine", "label": "Tournament Engine (server/engine/)", "file_type": "code", "source_file": ".claude/rules/engine.md", "source_location": "L6-L8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "engine_brainstorm", "label": "docs/brainstorm.md (\u00a70, \u00a77, \u00a78)", "file_type": "document", "source_file": ".claude/rules/engine.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "engine_pure_typescript", "label": "Engine is pure TypeScript with own I/O types", "file_type": "rationale", "source_file": ".claude/rules/engine.md", "source_location": "L12-L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Nuxt/h3/Nitro/Drizzle/app imports and no DTOs or rows, so it stays extractable as a versioned package and decoupled from the API contract; services translate rows to engine input and back."}, {"id": "engine_determinism", "label": "Deterministic engine with server-provided seed", "file_type": "rationale", "source_file": ".claude/rules/engine.md", "source_location": "L14-L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same input + seed gives same output; stable ordering, lowest index wins ties; no Math.random/Date.now; seed generated by the server with a cryptographic RNG when the round is created."}, {"id": "engine_exact_maths", "label": "Exact integer/BigInt weights", "file_type": "rationale", "source_file": ".claude/rules/engine.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No floating point in comparisons deciding pairings or rankings; lexicographic priority weights in BigInt or below 2^53."}, {"id": "engine_blossom_matching", "label": "Weighted maximum matching (blossom) pairing", "file_type": "rationale", "source_file": ".claude/rules/engine.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pairing never fails: no hard constraints, only weights in a fixed priority order, so a complete pairing is always returned."}, {"id": "engine_tiebreak_modules", "label": "Tiebreak catalogue modules (OMW%, GW%, Buchholz)", "file_type": "rationale", "source_file": ".claude/rules/engine.md", "source_location": "L18-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Core knows no tiebreak; ruleset picks an ordered list of modules with parameters; adding a game is composition, no DSL or interpreter."}, {"id": "engine_generation_signature", "label": "Round generation signature {engineVersion, seed, input}", "file_type": "rationale", "source_file": ".claude/rules/engine.md", "source_location": "L21-L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifying a round means engine(input, seed) == saved pairing; any output change for a given input is a new engine version."}], "edges": [{"source": "engine_tournament_engine", "target": "engine_brainstorm", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/rules/engine.md", "source_location": "L8", "weight": 1.0}, {"source": "engine_pure_typescript", "target": "engine_tournament_engine", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/rules/engine.md", "source_location": "L12-L13", "weight": 1.0}, {"source": "engine_determinism", "target": "engine_tournament_engine", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/rules/engine.md", "source_location": "L14-L15", "weight": 1.0}, {"source": "engine_exact_maths", "target": "engine_tournament_engine", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/rules/engine.md