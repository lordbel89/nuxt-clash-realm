{
  "name": "clash-realm",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test tests/engine/*.test.ts tests/backend/*.test.ts tests/integration/*.test.ts",
    "test:engine": "node --test tests/engine/*.test.ts",
    "test:backend": "node --test tests/backend/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:concurrency": "docker compose -f compose.test.yml up -d --wait && node --test tests/concurrency/*.test.ts",
    "test:scenario": "node --test --test-concurrency=1 tests/scenario/*.test.ts",
    "build": "nuxt build",
    "dev": "nuxt dev --port=3010",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node server/database/migrate.ts",
    "db:seed": "node server/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "user:create": "node scripts/user-create.ts",
    "api:spec": "node scripts/api-spec.ts",
    "format": "eslint --fix ."
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extension-code": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-drag-handle": "^3.31.3",
    "@tiptap/extension-drag-handle-vue-3": "^3.31.3",
    "@tiptap/extension-floating-menu": "^3.31.3",
    "@tiptap/extension-horizontal-rule": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-node-range": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^1.0.0-rc.4",
    "eslint": "^10.9.1",
    "nuxt": "^4.5.2",
    "pg-boss": "^12.38.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "valibot": "^1.4.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@faker-js/faker": "^10.6.0",
    "@iconify-json/lucide": "^1.2.129",
    "@valibot/to-json-schema": "~1.7.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "rou3": "^0.9.2",
    "ts-json-schema-generator": "^2.9.0",
    "vue-tsc": "^3.3.11"
  }
}
