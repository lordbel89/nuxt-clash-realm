# Copiare in .env e adattare. Le variabili NUXT_* alimentano runtimeConfig.

# pglite (sviluppo locale) | postgres (produzione)
NUXT_DATABASE_DIALECT=pglite

# Cartella dati di PGlite, usata solo con NUXT_DATABASE_DIALECT=pglite
NUXT_DATABASE_PGLITE_PATH=.data/pglite

# Connessione al Postgres di produzione, usata solo con NUXT_DATABASE_DIALECT=postgres
NUXT_DATABASE_URL=postgres://utente:password@host:5432/clash_realm

# Firma i cookie di sessione: obbligatorio in produzione, in sviluppo si usa un
# segreto di ripiego. Generarlo con: openssl rand -base64 32
NUXT_AUTH_SECRET=

# Origine dell'applicazione, usata da Better Auth per cookie e redirect
NUXT_AUTH_URL=http://localhost:3010

# Mock di server/mocks/ (solo in sviluppo): false li spegne tutti e risponde
# solo con gli handler veri. Gli scenari [S] li spengono da soli.
NUXT_MOCKS=true

# pg-boss (code e job persistenti): avvia il worker all'accensione. Spento in v1,
# da F7 (mailer, push, scadenze) in poi serve.
NUXT_JOBS_ENABLED=false

# --- Solo in produzione (CapRover, vedi docs/deploy.md) ---

# URL del ruolo owner, che possiede le tabelle: lo usa solo lo script di avvio del container per
# migrare. Il server gira col ruolo di NUXT_DATABASE_URL e non lo vede.
DATABASE_MIGRATION_URL=

# Il ruolo con cui gira il server: dopo ogni migrazione riceve i permessi (default clash_app)
DATABASE_APP_ROLE=clash_app
