# Copiare in .env e adattare. Le variabili NUXT_* alimentano runtimeConfig.

# pglite (sviluppo locale) | postgres (produzione)
NUXT_DATABASE_DIALECT=pglite

# Cartella dati di PGlite, usata solo con NUXT_DATABASE_DIALECT=pglite
NUXT_DATABASE_PGLITE_PATH=.data/pglite

# Connessione al Postgres di produzione, usata solo con NUXT_DATABASE_DIALECT=postgres
NUXT_DATABASE_URL=postgres://utente:password@host:5432/clash_realm

# Firma i cookie di sessione: obbligatorio in produzione, in sviluppo si usa un
# segreto di ripiego. Generarlo con: openssl rand -base64 32
NUXT_AUTH_SECRET=

# Origine dell'applicazione, usata da Better Auth per cookie e redirect
NUXT_AUTH_URL=http://localhost:3000
