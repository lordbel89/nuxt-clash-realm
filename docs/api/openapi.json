    "/api/users": {
      "get": {
        "tags": [
          "Utenti"
        ],
        "summary": "Rubrica degli utenti registrati",
        "description": "**Stato:** disponibile\n\nSolo id e nome, per cercare qualcuno da aggiungere a un'organizzazione. `search` trova il nome per sottostringa e l'email solo se scritta per intero. I dati privati stanno su `/api/users/me`.",
        "x-status": "available",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d+$",
              "default": "25"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d+$",
              "default": "0"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paginated_UserSummary"
                }
              }
            }
          },
          "400": {
            "description": "Dati non validi: i messaggi per campo sono in `data`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Autenticazione richiesta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
